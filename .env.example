# Copy to .env.local for local dev, and add the same keys in
# Vercel → Settings → Environment Variables (then redeploy).
#
# Brochure download lead capture → Google Sheet.
# Full setup walkthrough: scripts/google-sheet-leads.gs

# Apps Script Web app URL, ending in /exec
GOOGLE_SHEETS_WEBHOOK_URL=

# Must match SHARED_SECRET inside the Apps Script
GOOGLE_SHEETS_SHARED_SECRET=
