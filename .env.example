# Copy to .env.local for local dev, and add the same keys in
# Vercel → Settings → Environment Variables (then redeploy).
#
# Both website forms (brochure download + "Send Enquiry") post to a Google
# Apps Script web app, which emails you the lead and records it in a sheet.
# Full setup walkthrough: scripts/google-lead-handler.gs
#
# The names are historical — this endpoint now sends mail as well as writing
# to the sheet. Renaming them means updating Vercel too, so they're left as is.

# Apps Script Web app URL, ending in /exec
GOOGLE_SHEETS_WEBHOOK_URL=

# Must match SHARED_SECRET inside the Apps Script
GOOGLE_SHEETS_SHARED_SECRET=
